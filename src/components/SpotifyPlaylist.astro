---
interface Props { url?: string; title: string }
const { url, title } = Astro.props;
const id = url?.match(/\/playlist\/([a-zA-Z0-9]+)/)?.[1];
---
{id && <section class="playlist-embed" aria-label="Article playlist">
  <p class="kicker">This article’s playlist</p>
  <iframe title={`${title} — Spotify playlist`} src={`https://open.spotify.com/embed/playlist/${id}`} width="100%" height="352" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
</section>}
